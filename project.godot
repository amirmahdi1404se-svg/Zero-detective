; CASE ZERO - narrative investigation game
config_version=5

[application]
config/name="CASE ZERO"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#")
config/description="A cinematic interactive detective anthology."

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)

[dotnet]
project/assembly_name="CaseZero"
